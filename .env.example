# ---- Next.js (.env.local) ---------------------------------------------------
# Site origin. Also used as the JWT issuer for Convex; must equal CONVEX_AUTH_ISSUER.
AUTH_URL=http://localhost:3000
# next-auth session secret: openssl rand -base64 32
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From `npx convex dev` (dev) or the deployment settings (prod).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# RSA key pair that signs the Convex tokens. Generate once:
#   openssl genrsa -out private.pem 2048
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -out private-pkcs8.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste PEMs with literal "\n" for newlines when your env tooling needs one line.
CONVEX_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CONVEX_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CONVEX_JWT_KID=doko-1

# ---- Convex deployment (npx convex env set NAME value) -----------------------
# Must equal AUTH_URL exactly (no trailing slash). Convex fetches
# ${CONVEX_AUTH_ISSUER}/.well-known/jwks.json over the public internet.
# CONVEX_AUTH_ISSUER=https://your-app.example.com
# Public origin used in emails (invite links, ticket links). No localhost fallback.
# APP_URL=https://your-app.example.com
# >= 32 random chars; signs invite links.
# INVITE_SIGNING_SECRET=
# Gmail account + app password used by nodemailer.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# LLM providers for the morning brief (set at least the one you select).
# ANTHROPIC_API_KEY=
# GOOGLE_GENAI_API_KEY=
# LLM_BRIEF_PROVIDER=anthropic   # or google
# LLM_QUICK_PROVIDER=anthropic   # or google
# LLM_MOCK=1                     # dev only: canned briefs, no provider calls
# LLM_ALLOW_PROVIDER_COMPARE=1   # dev only: enables the provider comparison widget
